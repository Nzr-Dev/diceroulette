# Copy to .env (never commit .env). On Vercel, set the same names in Project Settings > Environment Variables.

# Neon: pooled address (the host contains «-pooler»). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon: direct address (no «-pooler»). Used only by the Prisma command line (migrate).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Secret: a long random text. Create one with:  npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Public address of the site: http://localhost:3000 while developing, your domain in production.
BETTER_AUTH_URL="http://localhost:3000"

# Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
